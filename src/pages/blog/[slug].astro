---
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import BlogLayout from '../../layouts/BlogLayout.astro'
import PostHeader from '../../components/blog/PostHeader.astro'
import { siteConfig } from '../../data/site'

export async function getStaticPaths() {
  const isDev = import.meta.env.DEV
  const posts = await getCollection('blog', ({ data }) => isDev || !data.draft)
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }))
}

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { Content } = await render(post)

const {
  title,
  description,
  publishedAt,
  updatedAt,
  category,
  tags,
  cover,
  ogImage,
  canonical: postCanonical,
  author,
} = post.data

const canonical = postCanonical ?? `${siteConfig.url}/blog/${post.id}`
const ogImageUrl = ogImage ?? cover?.src

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: publishedAt.toISOString(),
  ...(updatedAt ? { dateModified: updatedAt.toISOString() } : {}),
  author: {
    '@type': 'Person',
    name: author ?? siteConfig.author,
    url: siteConfig.url,
  },
  url: canonical,
  ...(cover ? { image: `${siteConfig.url}${cover.src}` } : {}),
}
---

<BlogLayout
  title={`${title} — ${siteConfig.author}`}
  description={description}
  canonical={canonical}
  ogImage={ogImageUrl}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="post">
    <PostHeader
      title={title}
      description={description}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      category={category}
      tags={tags}
      cover={cover}
      author={author}
    />
    <div class="post-content container">
      <Content />
    </div>
  </article>
</BlogLayout>

<style>
.post {
  padding-block-end: 8rem;
}

.post-content {
  max-width: 70rem;
  margin: 4rem auto 0;
}

.post-content :global(h2) {
  font-size: 2.4rem;
  font-weight: 700;
  color: var(--title-color);
  letter-spacing: -0.01em;
  line-height: 1.3;
  margin: 4rem 0 1.6rem;
}

.post-content :global(h3) {
  font-size: 2rem;
  font-weight: 600;
  color: var(--title-color);
  line-height: 1.35;
  margin: 3rem 0 1.2rem;
}

.post-content :global(p) {
  font-size: 1.7rem;
  color: var(--text-color);
  line-height: 1.85;
  margin: 0 0 2rem;
}

.post-content :global(ul),
.post-content :global(ol) {
  font-size: 1.7rem;
  color: var(--text-color);
  line-height: 1.8;
  padding-inline-start: 2.4rem;
  margin: 0 0 2rem;
}

.post-content :global(li) {
  margin-block-end: 0.6rem;
}

.post-content :global(strong) {
  color: var(--title-color);
  font-weight: 600;
}

.post-content :global(a) {
  color: var(--primary-color);
  text-decoration: underline;
  text-underline-offset: 3px;
}

.post-content :global(a:hover) {
  opacity: 0.8;
}

.post-content :global(code) {
  background: var(--surface-2);
  color: var(--primary-color);
  padding: 0.2em 0.5em;
  border-radius: var(--radius-xs);
  font-size: 0.88em;
  font-family: monospace;
}

.post-content :global(pre) {
  background: var(--surface-2);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 2rem 2.4rem;
  overflow-x: auto;
  margin: 0 0 2.4rem;
}

.post-content :global(pre code) {
  background: none;
  color: var(--text-color);
  padding: 0;
  font-size: 1.5rem;
  line-height: 1.7;
}

.post-content :global(blockquote) {
  border-inline-start: 3px solid var(--primary-color);
  background: var(--surface-1);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  padding: 1.4rem 2rem;
  margin: 0 0 2rem;
}

.post-content :global(blockquote p) {
  margin: 0;
  color: var(--text-muted);
}

.post-content :global(hr) {
  border: none;
  border-block-start: 1px solid var(--border-subtle);
  margin: 4rem 0;
}
</style>
