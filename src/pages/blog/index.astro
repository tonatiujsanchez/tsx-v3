---
import { getCollection } from 'astro:content'
import BlogLayout from '../../layouts/BlogLayout.astro'
import BlogCard from '../../components/blog/BlogCard.astro'
import FeaturedPostCard from '../../components/blog/FeaturedPostCard.astro'
import { siteConfig } from '../../data/site'

const isDev = import.meta.env.DEV

const allPosts = await getCollection('blog', ({ data }) => isDev || !data.draft)

const sorted = allPosts.sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
)

const featuredPost = sorted.find(post => post.data.featured)
const regularPosts = sorted.filter(post => post !== featuredPost)

const canonical = `${siteConfig.url}/blog`

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `Blog — ${siteConfig.author}`,
  description: 'Notas sobre IA, desarrollo web y herramientas para ingenieros de software.',
  url: canonical,
  author: {
    '@type': 'Person',
    name: siteConfig.author,
  },
}
---

<BlogLayout
  title={`Blog — ${siteConfig.author}`}
  description="Notas sobre IA, desarrollo web y herramientas para ingenieros de software."
  canonical={canonical}
  ogType="website"
  jsonLd={jsonLd}
>
  <section class="blog-index">
    <div class="container">
      <header class="blog-index__header" data-reveal>
        <h1 class="blog-index__title">Blog</h1>
        <p class="blog-index__lead">
          Notas sobre IA, desarrollo web y herramientas para ingenieros de software.
        </p>
      </header>

      {sorted.length === 0 ? (
        <div class="blog-index__empty" data-reveal>
          <div class="blog-index__empty-icon" aria-hidden="true">
            <i class="bx bx-edit-alt"></i>
          </div>
          <p class="blog-index__empty-text">Aún no hay artículos publicados.</p>
          <p class="blog-index__empty-hint">
            Estoy preparando notas sobre IA, desarrollo y herramientas.
          </p>
        </div>
      ) : (
        <>
          {featuredPost && (
            <div class="blog-index__featured" data-reveal>
              <FeaturedPostCard
                title={featuredPost.data.title}
                description={featuredPost.data.description}
                excerpt={featuredPost.data.excerpt}
                href={`/blog/${featuredPost.id}`}
                publishedAt={featuredPost.data.publishedAt}
                updatedAt={featuredPost.data.updatedAt}
                category={featuredPost.data.category}
                tags={featuredPost.data.tags}
                cover={featuredPost.data.cover}
              />
            </div>
          )}
          {regularPosts.length > 0 && (
            <div class="blog-index__grid" data-reveal-stagger>
              {regularPosts.map(post => (
                <BlogCard
                  title={post.data.title}
                  description={post.data.description}
                  excerpt={post.data.excerpt}
                  href={`/blog/${post.id}`}
                  publishedAt={post.data.publishedAt}
                  updatedAt={post.data.updatedAt}
                  category={post.data.category}
                  tags={post.data.tags}
                  cover={post.data.cover}
                />
              ))}
            </div>
          )}
        </>
      )}
    </div>
  </section>
</BlogLayout>

<style>
.blog-index {
  padding-block: 8rem;
  min-height: calc(100vh - 8rem);
}

.blog-index__header {
  max-width: 60rem;
  margin: 0 auto 6rem;
  text-align: center;
}

.blog-index__title {
  font-size: 4rem;
  font-weight: 700;
  color: var(--title-color);
  letter-spacing: -0.02em;
  margin: 0 0 1.6rem;
  line-height: 1.2;
}

@media (min-width: 768px) {
  .blog-index__title {
    font-size: 5.4rem;
  }
}

.blog-index__lead {
  font-size: 1.7rem;
  color: var(--text-muted);
  line-height: 1.7;
  margin: 0;
}

.blog-index__featured {
  margin-block-end: 5rem;
}

.blog-index__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2.4rem;
}

@media (min-width: 640px) {
  .blog-index__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .blog-index__grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.blog-index__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.2rem;
  padding: 10rem 2rem;
  text-align: center;
}

.blog-index__empty-icon {
  font-size: 4.8rem;
  color: var(--border-normal);
  line-height: 1;
  margin-block-end: 0.8rem;
}

.blog-index__empty-text {
  font-size: 2rem;
  font-weight: 600;
  color: var(--title-color);
  margin: 0;
}

.blog-index__empty-hint {
  font-size: 1.6rem;
  color: var(--text-muted);
  margin: 0;
  max-width: 40rem;
}
</style>
